{
  "name": "task-pilot-mobile",
  "version": "1.0.2",
  "main": "index.js",
  "private": true,
  "scripts": {
    "start": "expo start --offline",
    "clean": "expo start -c --offline",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "bundle:android": "npx expo export:embed --platform android --dev false --entry-file index.js --bundle-output android/app/src/main/assets/index.android.bundle --assets-dest android/app/src/main/res/",
    "build:apk": "cd android && ./gradlew assembleRelease",
    "build:apk:debug": "cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@notifee/react-native": "^9.1.8",
    "@react-native-google-signin/google-signin": "^16.1.5",
    "@react-navigation/bottom-tabs": "^6.5.20",
    "@react-navigation/native": "^6.1.17",
    "@react-navigation/native-stack": "^6.11.0",
    "@tanstack/react-query": "^5.102.8",
    "axios": "^1.20.0",
    "date-fns": "^4.4.0",
    "expo": "~57.0.21",
    "expo-notifications": "~57.0.17",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@types/react": "~19.2.4",
    "babel-preset-expo": "~57.0.0",
    "typescript": "~6.0.3"
  }
}
