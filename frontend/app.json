{
  "expo": {
    "name": "TaskPilot",
    "slug": "task-pilot",
    "scheme": "taskpilot",
    "version": "1.0.2",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "backgroundColor": "#EDF2F4",
    "android": {
      "package": "com.taskpilot.app",
      "versionCode": 3,
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#EDF2F4"
      }
    },
    "ios": {
      "bundleIdentifier": "com.taskpilot.app",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "extra": {
      "eas": {
        "projectId": "2b753a6a-a251-4446-8430-1140d7413da6"
      }
    },
    "plugins": [
      "expo-status-bar",
      "expo-notifications"
    ]
  }
}
