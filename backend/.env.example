# Copy this file to .env and fill in real values before running the server.

# PostgreSQL connection
DATABASE_URL=postgresql://postgres:password@localhost:5432/kalkakaam

# JWT secret for signing user + admin tokens (use a long random string in production)
JWT_SECRET=replace-this-with-a-long-random-string
ADMIN_JWT_SECRET=replace-this-with-a-different-long-random-string

# Admin Dashboard Credentials
ADMIN_EMAIL=admin@taskalert.com
ADMIN_PASSWORD=Admin@1234

# Server
PORT=4000

# Subscription pricing (paise, i.e. 39900 = ₹399.00)
SUBSCRIPTION_PRICE_PAISE=39900

# Free Zone daily reminder cap (also hardcoded as FREE_DAILY_LIMIT in routes/tasks.js)
FREE_DAILY_LIMIT=3

# Razorpay (or swap for Stripe / Google Play / App Store server keys)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# SMTP Email Configuration (Optional - for sending real password reset emails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM="TaskAlert <no-reply@taskalert.com>"
